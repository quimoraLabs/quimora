{
  "name": "quimora-root",
  "version": "1.0.0",
  "description": "Quimora - Full-Stack Modern Quiz & Learning Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "build": "npm run install:all && npm run build:frontend",
    "build:backend": "npm run install:backend",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "node scripts/codegen.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "concurrently": "^9.1.2"
  }
}
