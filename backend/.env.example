# ==========================================
# Quimora Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v2

# MongoDB Connection String (Main DB & Isolated Test DB)
MONGO_URI=mongodb://localhost:27017/quimora
MONGO_URI_TEST=mongodb://localhost:27017/quimora_test

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Groq AI Question Generation
GROQ_API_KEY=your_groq_api_key_here

# Optional Redis Cache
REDIS_URI=redis://localhost:6379

# Nodemailer / Email OTP Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ImageKit Configuration (for media & diagrams)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_url_endpoint
