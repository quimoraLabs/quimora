# ==========================================
# Quimora Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/quimora

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Nodemailer / Email OTP Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ImageKit Configuration (for media & diagrams)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_url_endpoint
